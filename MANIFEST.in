# MANIFEST.in
# sdist 资源清单：与 pyproject.toml 单一 packaging authority 对齐
include README.md
include pyproject.toml
include md_converter/py.typed
recursive-include md_converter *.py
recursive-include md_converter *.yaml
recursive-include md_converter/tests *.md
recursive-include md_converter/tests *.json
recursive-include md_converter/tests *.xml
